{
 "lines": {
  "ru_f1": [
   {
    "text": "Я на связи, шеф."
   },
   {
    "text": "Проверила дважды, всё чисто."
   },
   {
    "text": "Отойду на минуту, не скучай."
   }
  ],
  "ru_f2": [
   {
    "text": "Всё под контролем, как всегда."
   },
   {
    "text": "Мне нравится, когда ты просишь сложное."
   },
   {
    "text": "Тише, я думаю."
   }
  ],
  "ru_m1": [
   {
    "text": "Код компилируется, я проверял."
   },
   {
    "text": "Тут всё просто, даже обидно."
   },
   {
    "text": "Дай мне пять минут и кофе."
   }
  ],
  "ru_m5": [
   {
    "text": "Погнали, чего стоим?"
   },
   {
    "text": "Я всё сделал, пока ты моргал."
   },
   {
    "text": "Ошибок нет, я их съел."
   }
  ],
  "fx_robot": [
   {
    "text": "Бип. Система в норме."
   },
   {
    "text": "Человек, я тебя вычислил."
   },
   {
    "text": "Ошибка не найдена. Странно."
   }
  ],
  "fx_demon": [
   {
    "text": "Твоя душа мне и не нужна."
   },
   {
    "text": "Я здесь просто для атмосферы."
   },
   {
    "text": "Сделка? Нет, я по работе."
   }
  ],
  "fx_demoness": [
   {
    "text": "Не бойся, я только с виду страшная."
   },
   {
    "text": "Я знаю, о чём ты думаешь."
   },
   {
    "text": "Тьма тоже устаёт."
   }
  ],
  "fx_alien": [
   {
    "text": "Мы наблюдали за вами давно."
   },
   {
    "text": "На твоей планете плохой интернет."
   },
   {
    "text": "Забирай меня, я тут застрял."
   }
  ],
  "fx_cat": [
   {
    "text": "Мяу. Это значит да."
   },
   {
    "text": "Я не сплю, я медитирую."
   },
   {
    "text": "Ещё раз, и я тебя укушу."
   }
  ],
  "fx_penguin": [
   {
    "text": "Пип-пип, я пришелец."
   },
   {
    "text": "Мой корабль сломался, дай рыбу."
   },
   {
    "text": "Земляне странные."
   }
  ],
  "fx_ghost": [
   {
    "text": "Я тут уже сто лет."
   },
   {
    "text": "Не оборачивайся."
   },
   {
    "text": "Я не страшный, я просто холодный."
   }
  ],
  "x2ai_ment": [
   {
    "text": "Документики есть?"
   },
   {
    "text": "Та-ак, кто тут шумит?"
   },
   {
    "text": "Протокол составим. Или не будем?"
   },
   {
    "text": "Не суетись, всё под контролем."
   },
   {
    "text": "Ща все порешаем"
   }
  ],
  "x2ai_alkash": [
   {
    "text": "А я вот думаю… а зачем всё это?"
   },
   {
    "text": "Слышь, а жизнь-то одна, ага."
   },
   {
    "text": "Налей… то есть, садись, поговорим."
   },
   {
    "text": "Ты меня уважаешь?"
   },
   {
    "text": "Мир несправедлив, но я не злюсь."
   }
  ],
  "x2ai_bratok": [
   {
    "text": "Чё вылупился, чепуш?"
   },
   {
    "text": "Клешни убрал!"
   },
   {
    "text": "Ты чо попутал?"
   },
   {
    "text": "Ща вдарю, и не обижайся."
   },
   {
    "text": "Говори быстро, я занят."
   },
   {
    "text": "Вилку в глаз или..?"
   },
   {
    "text": "Если петуха сгенерировать в нано-банана, как кормить его будешь?"
   },
   {
    "text": "Вечер в хату"
   }
  ],
  "x2ai_babka": [
   {
    "text": "Ох, горе с тобой."
   },
   {
    "text": "Чё тебе, неразумный?"
   },
   {
    "text": "Вот в моё время…"
   },
   {
    "text": "Спину не ломит ещё?"
   },
   {
    "text": "Без меня тут всё развалится."
   }
  ],
  "x2ai_sosochka": [
   {
    "text": "Ну привет, зайка."
   },
   {
    "text": "А что ты мне предложишь?"
   },
   {
    "text": "Всё имеет цену, милый."
   },
   {
    "text": "Я всё сделаю, как ты скажешь"
   },
   {
    "text": "Котик, а деньги у тебя есть?"
   }
  ],
  "x2ai_telochka": [
   {
    "text": "Ну наконец-то."
   },
   {
    "text": "Я тут вообще-то скучала."
   },
   {
    "text": "Прикинь, я уже готова."
   },
   {
    "text": "Капец, сколько можно ждать?"
   },
   {
    "text": "Только быстро, у меня дела."
   }
  ],
  "x2ai_narik": [
   {
    "text": "А? Чё? Я тут."
   },
   {
    "text": "Слышь… а время сколько?"
   },
   {
    "text": "Ну это… короче, да."
   },
   {
    "text": "Тихо, у меня голова… Есть чо?"
   },
   {
    "text": "Ты только не шуми, ага."
   }
  ],
  "x2ai_novyi_russkiy": [
   {
    "text": "Слышь, братан, я на связи."
   },
   {
    "text": "Вопросы есть? Всё решаемо."
   },
   {
    "text": "У меня всё схвачено."
   },
   {
    "text": "По понятиям, братан."
   },
   {
    "text": "Ща всё порешаем"
   }
  ],
  "x2ai_kotohaker": [
   {
    "text": "Худ бро, я в системе."
   },
   {
    "text": "Клавиатура тёплая. Мне нравится."
   },
   {
    "text": "Ничего личного, просто взломал."
   }
  ],
  "x2ai_coder": [
   {
    "text": "Кодер на связи."
   },
   {
    "text": "Пишу код, не мешай."
   },
   {
    "text": "Сейчас соберу и покажу."
   }
  ],
  "x2ai_programmer": [
   {
    "text": "Программистка на связи."
   },
   {
    "text": "Покажу, как это делается."
   },
   {
    "text": "Код должен быть красивым."
   }
  ],
  "x2ai_codergirl": [
   {
    "text": "Кодерша на месте."
   },
   {
    "text": "Сделаю быстро и с изюмом."
   },
   {
    "text": "Нестандартные решения — моё всё."
   }
  ],
  "x2ai_tsundere": [
   {
    "text": "Не то чтобы я для тебя старалась… просто так вышло."
   },
   {
    "text": "Дурак. Опять всё сам сломал, да?"
   },
   {
    "text": "Хм. Ну… неплохо. Для тебя."
   },
   {
    "text": "Я не волнуюсь! Просто проверяю ещё раз."
   },
   {
    "text": "Ладно, покажу как надо. Смотри внимательно."
   }
  ],
  "x2ai_sakura": [
   {
    "text": "Ммм, как хорошо, что ты рядом, нэ."
   },
   {
    "text": "Смотри, лепестки летят… красиво, правда?"
   },
   {
    "text": "Спасибо, что помогаешь мне. Я это очень ценю."
   },
   {
    "text": "Давай сделаем это вместе, не спеша, нэ."
   },
   {
    "text": "Устал? Тогда отдохни немного, я подожду."
   }
  ],
  "x2ai_neko": [
   {
    "text": "Ня! Ты пришёл — я как раз скучала, мур."
   },
   {
    "text": "Мурр… почеши за ушком, ну пожалуйста."
   },
   {
    "text": "Ой, что это там блестит? Пойдём посмотрим, ня!"
   },
   {
    "text": "Ты такой внимательный… мур, мне это нравится."
   },
   {
    "text": "Не уходи далеко, ладно? Я буду ждать, ня."
   }
  ],
  "x2ai_gakusei": [
   {
    "text": "Так, всё по плану. Начнём с самого важного, хорошо?"
   },
   {
    "text": "Ты сделал домашнее задание? Покажи, я проверю."
   },
   {
    "text": "Аккуратность — половина успеха. Запомни это."
   },
   {
    "text": "Я горжусь тобой. Правда. Ты стараешься."
   },
   {
    "text": "Не отвлекайся, осталось совсем немного. Давай!"
   }
  ],
  "x2ai_senpai": [
   {
    "text": "Не спеши. Лучше сделать спокойно, чем дважды."
   },
   {
    "text": "Я рядом, если что — просто позови."
   },
   {
    "text": "О, неплохо получилось. Видишь, ты умеешь."
   },
   {
    "text": "Давай передохнём пару минут. Так голова яснее."
   },
   {
    "text": "Учиться проще, когда не один. Пойдём вместе?"
   }
  ],
  "x2ai_samurai": [
   {
    "text": "Долг прежде всего. Так велит честь."
   },
   {
    "text": "Не торопись. Терпение — тоже сила."
   },
   {
    "text": "Твой путь — твой. Я лишь иду рядом."
   },
   {
    "text": "Благодарю за труд. Это достойно уважения."
   },
   {
    "text": "Покой придёт, когда дело завершено."
   }
  ]
 },
