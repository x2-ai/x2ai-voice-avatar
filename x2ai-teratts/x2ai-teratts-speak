#!/bin/bash
# x2ai-teratts-speak — озвучить текст локальным TeraTTSv2.
# Текст читается со stdin. Поднимает тёплый сервер, если он не запущен,
# и печатает ответ сервера JSON-строкой. Код выхода != 0 — озвучка не удалась.
#
# Лёгкий путь: один процесс python (send.py) на попытку. Никаких опросов
# «жив ли сервер» в цикле — только отправка и, при необходимости, один старт.
set -uo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$HOME/.config/opencode/teratts-venv/bin/python"
SOCK="${TERATTS_SOCK:-/tmp/x2ai-teratts.sock}"
LOG="${TERATTS_LOG:-$HOME/.config/opencode/x2ai-teratts.log}"
LOCKD="${TERATTS_LOCK:-/tmp/x2ai-teratts-start.d}"
SEND="$DIR/send.py"
PY="${TERATTS_CLIENT_PY:-/usr/bin/python3}"

text="$(cat)"
if [ -z "$(printf '%s' "$text" | tr -d '[:space:]')" ]; then
  echo '{"ok":false,"error":"empty"}'
  exit 1
fi

export X2AI_TTS_TEXT="$text"

start_server() {
  "$VENV" - "$VENV" "$DIR/server.py" "$LOG" <<'PY'
import subprocess, sys

venv, srv, log = sys.argv[1:4]
with open(log, "ab") as fh:
    subprocess.Popen(
        [venv, srv],
        stdin=subprocess.DEVNULL,
        stdout=fh,
        stderr=fh,
        start_new_session=True,
        close_fds=True,
        cwd=srv.rsplit("/", 1)[0],
    )
PY
  # Сокет создаётся до загрузки модели (меньше секунды), поэтому долго ждать
  # нечего: если за 10 с его нет, сервер не поднялся.
  for _ in $(seq 1 40); do
    [ -S "$SOCK" ] && break
    sleep 0.25
  done
}

wait_socket() {
  for _ in $(seq 1 240); do
    [ -S "$SOCK" ] && break
    sleep 0.5
  done
}

"$PY" "$SEND" "$SOCK"
rc=$?

if [ "$rc" -eq 3 ] || [ "$rc" -eq 4 ]; then
  # 4 — сокет-мусор от умершего сервера: его можно удалить. 3 — файла нет
  # вовсе; трогать чужой живой сокет нельзя, иначе сервер остаётся жив, но
  # недоступен, и все следующие фразы теряются («already running» в логе).
  [ "$rc" -eq 4 ] && rm -f "$SOCK"
  owner=0
  if mkdir "$LOCKD" 2>/dev/null; then
    owner=1
    start_server
    rmdir "$LOCKD" 2>/dev/null || true
  else
    wait_socket
  fi
  # Сервер мог быть жив, но с потерянным сокетом: новый не стартует из-за
  # блокировки, а фразы уходят в пустоту. Снимаем недоступный процесс и
  # поднимаем сервер заново.
  if [ "$owner" -eq 1 ] && [ ! -S "$SOCK" ]; then
    echo "$(date -u +%FT%TZ) stale server without socket, restart" >>"$LOG"
    pkill -x x2ai-voice 2>/dev/null
    for _ in $(seq 1 40); do
      pgrep -x x2ai-voice >/dev/null || break
      sleep 0.25
    done
    rm -f "$SOCK"
    start_server
  fi
  "$PY" "$SEND" "$SOCK"
  exit $?
fi

exit "$rc"
